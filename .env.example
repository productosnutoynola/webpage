# Wompi — https://comercios.wompi.co → Desarrolladores
# Usa las llaves de pruebas (pub_test_ / test_integrity_ / test_events_) hasta validar el flujo.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxx

# URL pública del sitio (Wompi redirige aquí después del pago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). La service role key es SOLO de servidor: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
